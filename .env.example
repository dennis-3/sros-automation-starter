# ==============================================================================
# Nokia SR OS Automation Starter - Environment Variables Example
# ==============================================================================
# Copy this file to .env before deploying:
#   cp .env.example .env
#
# Note: .env is ignored by Git to protect sensitive credentials.
# ==============================================================================

# --- Device Credentials ---
SROS_USER=admin
SROS_PASSWORD=NokiaSros1!
SROS_PORT=830

# --- Containerlab & Image Configuration ---
SROS_IMAGE=localhost/nokia/srsim:25.7.R1
SROS_LICENSE=license/license.txt

# --- Dynamic Inventory (Optional - NetBox) ---
# NETBOX_URL=http://172.17.0.1:8000
# NETBOX_TOKEN=your_secure_netbox_token_here

# --- Ansible Execution Parameters ---
ANSIBLE_HOST_KEY_CHECKING=False
