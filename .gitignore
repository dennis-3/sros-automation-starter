# Ignore all containerlab runtime directories
**/clab-*/

*.log
*.json
!dashboards/*.json

.env
*.env
!.env.example

# Nokia SR OS License keys (do not commit actual license files)
license/*.txt
!license/*.example
!license/license.txt.example

# Local service mounts & runner environments
netbox/
actions-runner/
zabbix_mysql_data/

# Ignore Python virtual environments
.venv/
venv/
**/.venv-galaxy/

# Ignore python pycache & caches
__pycache__/
*.pyc
*.pyo
.cache/

# Ignore ansible collections & build contexts
**/collections/
**/context/

# Ignore pyATS test snapshots & reports
snapshots/
*.html

# Ignore OS files & drawio backups
.DS_Store
Thumbs.db
.$*.bkp
*.bkp

# Ignore local YANG models cache
.yang/

# ignore google drive sync files
.tmp.drive*

# Ignore AI agent workspace configurations
.agents/
