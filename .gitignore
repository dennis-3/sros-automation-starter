# Ignore all containerlab runtime directories
**/clab-*/

*.log
*.json

*.env

# don't track netbox and instead clone it locally when it is needed, 
# **/netbox # uncomment this in the actual lab to ignore netbox

# --- GITHUB ACTIONS RUNNER --- 
# actions-runner/ # uncomment this in the actual lab to ignore the github actions runner

# ignore Python virtual environments
venv/
**/.venv-galaxy/


# ignore text files
*.txt

# ignore python pycache
__pycache__/
*.pyc

# ignore ansible collections
**/collections

# ignore ansble build context
**/context/

# **/zabbix_mysql_data/ # uncomment this in the actual lab to ignore mysql data for zabbix
