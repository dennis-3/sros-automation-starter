<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>{{ router_instance | default('Base') }}</router-name>

            {# Global AS and Router ID #}
            <autonomous-system>{{ bgp.asn }}</autonomous-system>

            {# Global Aggregates (Summary Routes) #}
            {% if bgp.aggregates is defined and bgp.aggregates %}
            <aggregates>
                {% for agg in bgp.aggregates %}
                {% if agg.state | default('present') == 'absent' %}
                <aggregate nc:operation="remove">
                    <ip-prefix>{{ agg.prefix }}</ip-prefix>
                </aggregate>
                {% else %}
                <aggregate>
                    <ip-prefix>{{ agg.prefix }}</ip-prefix>
                </aggregate>
                {% endif %}
                {% endfor %}
            </aggregates>
            {% endif %}

            <bgp>
                <admin-state>{{ bgp.admin_state | default('enable') }}</admin-state>

                {% if bgp.router_id is defined %}
                <router-id>{{ bgp.router_id }}</router-id>
                {% endif %}

                {# 1. The Inter-AS Model B Essence #}
                {% if bgp.inter_as_vpn | default(false) %}
                <inter-as-vpn>true</inter-as-vpn>
                {% endif %}

                {# For Inter-AS Model B #}
                {% if bgp.asbr | default(false) %}
                <vpn-apply-export>true</vpn-apply-export>
                <vpn-apply-import>true</vpn-apply-import>
                {% endif %}

                {# Loop through every BGP group (iBGP and eBGP) #}
                {% for group in bgp.groups %}
                {% if group.state | default('present') == 'absent' %}
                <group nc:operation="remove">
                    <group-name>{{ group.name }}</group-name>
                </group>
                {% else %}
                <group>
                    <group-name>{{ group.name }}</group-name>
                    <admin-state>{{ group.admin_state | default('enable') }}</admin-state>

                    {% if group.description is defined %}
                    <description>{{ group.description }}</description>
                    {% endif %}

                    {% if group.local_address is defined %}
                    <local-address>{{ group.local_address }}</local-address>
                    {% endif %}

                    {% if group.advertise_inactive  %}
                    <advertise-inactive>{{ group.advertise_inactive | default(false) }}</advertise-inactive>
                    {% endif %}

                    {# Use peer_as if defined (eBGP), otherwise use local asn (iBGP) #}
                    <peer-as>{{ group.peer_as | default(bgp.asn) }}</peer-as>

                    {# eBGP Specific Flags #}
                    {% if group.loop_detect is defined %}
                    <loop-detect>{{ group.loop_detect }}</loop-detect>
                    {% endif %}

                    {% if group.next_hop_self | default(false) %}
                    <next-hop-self>true</next-hop-self>
                    {% endif %}

                    {# Route Reflector Logic #}
                    {% if group.cluster_id is defined %}
                    <cluster>
                        <cluster-id>{{ group.cluster_id }}</cluster-id>
                    </cluster>
                    {% endif %}

                    {# Enable Multihop for PE-to-PE peering #}
                    {% if group.multihop is defined %}
                    <multihop>{{ group.multihop }}</multihop>
                    {% endif %}

                    {% if group.family is defined and group.family %}
                    <family>
                        {% if group.family is mapping %}
                        {% for fam, state in group.family.items() %}
                        <{{ fam | replace('_', '-') }}>{{ 'true' if state else 'false' }}</{{ fam | replace('_', '-') }}>
                        {% endfor %}
                        {% elif group.family is iterable and group.family is not string %}
                        {% for fam in group.family %}
                        <{{ fam | replace('_', '-') }}>true</{{ fam | replace('_', '-') }}>
                        {% endfor %}
                        {% endif %}
                    </family>
                    {% endif %}

                    {# Authentication & Timers #}
                    {% if group.authentication_key is defined %}
                    <authentication-key>{{ group.authentication_key }}</authentication-key>
                    {% endif %}

                    {% if group.hold_time is defined %}
                    <hold-time>{{ group.hold_time }}</hold-time>
                    {% endif %}

                    {% if group.keepalive is defined %}
                    <keepalive>{{ group.keepalive }}</keepalive>
                    {% endif %}

                    {# Policy Handling #}
                    {% if group.export_policy is defined and group.export_policy %}
                    <export>
                        {% for policy in group.export_policy %}
                        <policy>{{ policy }}</policy>
                        {% endfor %}
                    </export>
                    {% endif %}

                    {% if group.import_policy is defined and group.import_policy %}
                    <import>
                        {% for policy in group.import_policy %}
                        <policy>{{ policy }}</policy>
                        {% endfor %}
                    </import>
                    {% endif %}
                </group>
                {% endif %}
                {% endfor %}

                {# Neighbor Configuration #}
                {% for group in bgp.groups %}
                {% for neighbor in group.neighbors %}
                {% if neighbor.state | default('present') == 'absent' %}
                <neighbor nc:operation="remove">
                    <ip-address>{{ neighbor.ip }}</ip-address>
                </neighbor>
                {% else %}
                <neighbor>
                    <ip-address>{{ neighbor.ip }}</ip-address>
                    <admin-state>{{ neighbor.admin_state | default('enable') }}</admin-state>
                    {% if neighbor.description is defined %}
                    <description>{{ neighbor.description }}</description>
                    {% endif %}
                    <group>{{ group.name }}</group>
                    {% if neighbor.peer_as is defined %}
                    <peer-as>{{ neighbor.peer_as }}</peer-as>
                    {% endif %}
                    {% if neighbor.local_address is defined %}
                    <local-address>{{ neighbor.local_address }}</local-address>
                    {% endif %}
                    {% if neighbor.authentication_key is defined %}
                    <authentication-key>{{ neighbor.authentication_key }}</authentication-key>
                    {% endif %}
                    {% if neighbor.export_policy is defined and neighbor.export_policy %}
                    <export>
                        {% for policy in neighbor.export_policy %}
                        <policy>{{ policy }}</policy>
                        {% endfor %}
                    </export>
                    {% endif %}
                    {% if neighbor.import_policy is defined and neighbor.import_policy %}
                    <import>
                        {% for policy in neighbor.import_policy %}
                        <policy>{{ policy }}</policy>
                        {% endfor %}
                    </import>
                    {% endif %}
                </neighbor>
                {% endif %}
                {% endfor %}
                {% endfor %}
            </bgp>
        </router>
    </configure>
</config>
