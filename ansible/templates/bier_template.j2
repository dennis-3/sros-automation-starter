<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>{{ router_instance | default('Base') }}</router-name>
            <bier>
                <admin-state>{{ bier.admin_state | default('enable') }}</admin-state>

                {% if bier.templates is defined %}
                {% for tmpl in bier.templates %}
                {% if tmpl.state | default('present') == 'absent' %}
                <template nc:operation="remove">
                    <template-name>{{ tmpl.name }}</template-name>
                </template>
                {% else %}
                <template>
                    <template-name>{{ tmpl.name }}</template-name>
                    <admin-state>{{ tmpl.admin_state | default('enable') }}</admin-state>

                    {% if tmpl.sub_domains is defined %}
                    {% for sub in tmpl.sub_domains %}
                    <sub-domain>
                        {# Keyed by start and end #}
                        <start>{{ sub.start }}</start>
                        <end>{{ sub.end }}</end>

                        {% if sub.bfr_id is defined %}
                        <bfr-id>{{ sub.bfr_id }}</bfr-id>
                        {% endif %}

                        {% if sub.prefix is defined %}
                        <prefix>{{ sub.prefix }}</prefix>
                        {% endif %}

                        {% if sub.multi_topology is defined %}
                        <multi-topology>{{ sub.multi_topology }}</multi-topology>
                        {% endif %}
                    </sub-domain>
                    {% endfor %}
                    {% endif %}
                </template>
                {% endif %}
                {% endfor %}
                {% endif %}

                {# Global BIER features #}
                {% if bier.fast_reroute is defined %}
                <fast-reroute>{{ bier.fast_reroute | lower }}</fast-reroute>
                {% endif %}
            </bier>
        </router>
    </configure>
</config>
