<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">

        <service>
            {% for epipe in epipe_services %}
            <epipe>
                <service-name>{{ epipe.id }}</service-name>
                <customer>1</customer>

                {# Enable VC-Switching if flag is present #}
                {% if epipe.vc_switching | default(false) %}
                <vc-switching>true</vc-switching>
                {% endif %}

                {# Build SAPs if they exist #}
                {% if epipe.saps is defined %}
                {% for sap in epipe.saps %}
                <sap>
                    <sap-id>{{ sap.id }}</sap-id>
                    <admin-state>enable</admin-state>
                </sap>
                {% endfor %}
                {% endif %}

                {# Render Spoke-SDPs with sdp:vc concatenation #}
                {% if epipe.spokes is defined %}
                {% for spoke in epipe.spokes %}
                <spoke-sdp>
                    <sdp-bind-id>{{ spoke.sdp_id }}:{{ spoke.vc_id }}</sdp-bind-id>
                    <admin-state>enable</admin-state>
                </spoke-sdp>
                {% endfor %}
                {% endif %}

                <admin-state>enable</admin-state>
            </epipe>
            {% endfor %}
        </service>

    </configure>
</config>
