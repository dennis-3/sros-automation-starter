<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">

        <service>
            {% for epipe in epipe_services %}
            {% if epipe.state | default('present') == 'absent' %}
            <epipe operation="remove">
                <service-name>{{ epipe.name | default(epipe.id) }}</service-name>
            </epipe>
            {% else %}
            <epipe>
                <service-name>{{ epipe.name | default(epipe.id) }}</service-name>
                {% if epipe.id is defined %}
                <service-id>{{ epipe.id }}</service-id>
                {% endif %}
                <customer>{{ epipe.customer_id | default('1') }}</customer>
                {% if epipe.description is defined %}
                <description>{{ epipe.description }}</description>
                {% endif %}

                {# Enable VC-Switching if flag is present #}
                {% if epipe.vc_switching | default(false) %}
                <vc-switching>true</vc-switching>
                {% endif %}

                {# Build SAPs if they exist #}
                {% if epipe.saps is defined %}
                {% for sap in epipe.saps %}
                {% if sap.state | default('present') == 'absent' %}
                <sap operation="remove">
                    <sap-id>{{ sap.sap_id | default(sap.id) }}</sap-id>
                </sap>
                {% else %}
                <sap>
                    <sap-id>{{ sap.sap_id | default(sap.id) }}</sap-id>
                    <admin-state>{{ sap.admin_state | default('enable') }}</admin-state>

                    {# Ingress QoS Logic #}
                    {% if sap.ingress_qos is defined %}
                    <ingress>
                        <qos>
                            <sap-ingress>
                                <policy-name>{{ sap.ingress_qos }}</policy-name>
                            </sap-ingress>
                        </qos>
                    </ingress>
                    {% endif %}

                    {# Egress QoS Logic #}
                    {% if sap.egress_qos is defined %}
                    <egress>
                        <qos>
                            <sap-egress>
                                <policy-name>{{ sap.egress_qos }}</policy-name>
                            </sap-egress>
                        </qos>
                    </egress>
                    {% endif %}
                </sap>
                {% endif %}
                {% endfor %}
                {% endif %}

                {# Render Spoke-SDPs with sdp:vc concatenation #}
                {% if epipe.spokes is defined %}
                {% for spoke in epipe.spokes %}
                {% set spoke_bind_id = spoke.sdp_bind_id | default(spoke.sdp_id ~ ':' ~ spoke.vc_id) %}
                {% if spoke.state | default('present') == 'absent' %}
                <spoke-sdp operation="remove">
                    <sdp-bind-id>{{ spoke_bind_id }}</sdp-bind-id>
                </spoke-sdp>
                {% else %}
                <spoke-sdp>
                    <sdp-bind-id>{{ spoke_bind_id }}</sdp-bind-id>
                    <admin-state>{{ spoke.admin_state | default('enable') }}</admin-state>
                </spoke-sdp>
                {% endif %}
                {% endfor %}
                {% endif %}

                <admin-state>{{ epipe.admin_state | default('enable') }}</admin-state>
            </epipe>
            {% endif %}
            {% endfor %}
        </service>

    </configure>
</config>
