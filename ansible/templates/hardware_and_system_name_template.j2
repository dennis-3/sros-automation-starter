<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">

        {# --- System Identity --- #}
        {% if system_name is defined %}
        <system>
            <name>{{ system_name }}</name>
        </system>
        {% endif %}

        {# --- Card & MDA Provisioning --- #}
        {% if cards is defined %}
        {% for card in cards %}
        <card>
            <slot-number>{{ card.slot | default(card.slot_number) }}</slot-number>
            <card-type>{{ card.type | default(card.card_type) }}</card-type>
            <admin-state>{{ card.admin_state | default('enable') }}</admin-state>
            {% for mda in card.mdas | default([]) %}
            <mda>
                <mda-slot>{{ mda.slot | default(mda.mda_slot) }}</mda-slot>
                <mda-type>{{ mda.type | default(mda.mda_type) }}</mda-type>
                <admin-state>{{ mda.admin_state | default('enable') }}</admin-state>
            </mda>
            {% endfor %}
        </card>
        {% endfor %}
        {% endif %}

        {# --- Port Provisioning (Connectors, Channelized Sub-Ports & Ethernet) --- #}
        {% if ports is defined %}
        {% for port in ports %}
        <port>
            <port-id>{{ port.id | default(port.port_id) }}</port-id>
            <admin-state>{{ port.admin_state | default('enable') }}</admin-state>
            {% if port.description is defined %}
            <description>{{ port.description }}</description>
            {% endif %}

            {# Connector Breakout #}
            {% if port.connector is defined or port.breakout is defined %}
            {% if port.connector is mapping and port.connector.breakout is defined %}
            {% set c_breakout = port.connector.breakout %}
            {% else %}
            {% set c_breakout = port.breakout | default(port.connector) %}
            {% endif %}
            <connector>
                <breakout>{{ c_breakout }}</breakout>
            </connector>
            {% endif %}

            {# Ethernet Port Configuration #}
            {% if port.ethernet is defined or port.mode is defined or port.encap_type is defined %}
            {% if port.ethernet is mapping and port.ethernet.mode is defined %}
            {% set eth_mode = port.ethernet.mode %}
            {% else %}
            {% set eth_mode = port.mode | default('hybrid') %}
            {% endif %}
            {% if port.ethernet is mapping and port.ethernet.encap_type is defined %}
            {% set eth_encap = port.ethernet.encap_type %}
            {% else %}
            {% set eth_encap = port.encap_type | default('dot1q') %}
            {% endif %}
            <ethernet>
                <mode>{{ eth_mode }}</mode>
                <encap-type>{{ eth_encap }}</encap-type>
                {% if port.ethernet is mapping and port.ethernet.mtu is defined %}
                <mtu>{{ port.ethernet.mtu }}</mtu>
                {% elif port.mtu is defined %}
                <mtu>{{ port.mtu }}</mtu>
                {% endif %}
            </ethernet>
            {% endif %}
        </port>

        {# Grouped Sub-Ports under Connector (if specified hierarchically) #}
        {% if port.channels is defined or port.sub_ports is defined %}
        {% for sub in (port.channels | default(port.sub_ports)) %}
        <port>
            <port-id>{{ sub.id if sub is mapping else sub }}</port-id>
            <admin-state>{{ (sub.admin_state | default('enable')) if sub is mapping else 'enable' }}</admin-state>
            {% if sub is mapping and sub.description is defined %}
            <description>{{ sub.description }}</description>
            {% endif %}
            <ethernet>
                <mode>{{ (sub.mode | default('hybrid')) if sub is mapping else 'hybrid' }}</mode>
                <encap-type>{{ (sub.encap_type | default('dot1q')) if sub is mapping else 'dot1q' }}</encap-type>
                {% if sub is mapping and sub.mtu is defined %}
                <mtu>{{ sub.mtu }}</mtu>
                {% endif %}
            </ethernet>
        </port>
        {% endfor %}
        {% endif %}
        {% endfor %}
        {% endif %}

    </configure>
</config>
