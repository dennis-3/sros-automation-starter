<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">

        {# --- System Identity --- #}
        {% if system_name is defined %}
        <system>
            <name>{{ system_name }}</name>
        </system>
        {% endif %}

        {# --- Card & MDA Provisioning --- #}
        {% if cards is defined %}
        {% for card in cards %}
        <card>
            <slot-number>{{ card.slot }}</slot-number>
            <card-type>{{ card.type }}</card-type>
            <admin-state>{{ card.admin_state | default('enable') }}</admin-state>
            {% for mda in card.mdas | default([]) %}
            <mda>
                <mda-slot>{{ mda.slot }}</mda-slot>
                <mda-type>{{ mda.type }}</mda-type>
                <admin-state>{{ mda.admin_state | default('enable') }}</admin-state>
            </mda>
            {% endfor %}
        </card>
        {% endfor %}
        {% endif %}

        {# --- Port Provisioning (Connectors, Channelized Sub-Ports & Ethernet) --- #}
        {% if ports is defined %}
        {% for port in ports %}
        <port>
            <port-id>{{ port.id }}</port-id>
            <admin-state>{{ port.admin_state | default('enable') }}</admin-state>
            {% if port.description is defined %}
            <description>{{ port.description }}</description>
            {% endif %}

            {# Connector Breakout #}
            {% if port.connector is defined and port.connector.breakout is defined %}
            <connector>
                <breakout>{{ port.connector.breakout }}</breakout>
            </connector>
            {% endif %}

            {# Ethernet Port Configuration #}
            {% if port.ethernet is defined %}
            <ethernet>
                <mode>{{ port.ethernet.mode | default('hybrid') }}</mode>
                <encap-type>{{ port.ethernet.encap_type | default('dot1q') }}</encap-type>
                {% if port.ethernet.mtu is defined %}
                <mtu>{{ port.ethernet.mtu }}</mtu>
                {% endif %}
            </ethernet>
            {% endif %}
        </port>

        {# Grouped Sub-Ports under Connector (if specified hierarchically) #}
        {% if port.channels is defined %}
        {% for sub in port.channels %}
        <port>
            <port-id>{{ sub.id if sub is mapping else sub }}</port-id>
            <admin-state>{{ (sub.admin_state | default('enable')) if sub is mapping else 'enable' }}</admin-state>
            {% if sub is mapping and sub.description is defined %}
            <description>{{ sub.description }}</description>
            {% endif %}
            <ethernet>
                <mode>{{ (sub.mode | default('hybrid')) if sub is mapping else 'hybrid' }}</mode>
                <encap-type>{{ (sub.encap_type | default('dot1q')) if sub is mapping else 'dot1q' }}</encap-type>
                {% if sub is mapping and sub.mtu is defined %}
                <mtu>{{ sub.mtu }}</mtu>
                {% endif %}
            </ethernet>
        </port>
        {% endfor %}
        {% endif %}
        {% endfor %}
        {% endif %}

    </configure>
</config>
