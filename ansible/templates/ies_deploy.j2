<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <service>
            {% for ies in ies_services %}
            {% if ies.state | default('present') == 'absent' %}
            <ies operation="remove">
                <service-name>{{ ies.name }}</service-name>
            </ies>
            {% else %}
            <ies>
                <service-name>{{ ies.name }}</service-name>
                <service-id>{{ ies.id }}</service-id>
                <customer>{{ ies.customer_id | default('1') }}</customer>
                {% if ies.description is defined %}
                <description>{{ ies.description }}</description>
                {% endif %}

                {% for iface in ies.interfaces | default([]) %}
                {% if iface.state | default('present') == 'absent' %}
                <interface operation="remove">
                    <interface-name>{{ iface.name }}</interface-name>
                </interface>
                {% else %}
                <interface>
                    <interface-name>{{ iface.name }}</interface-name>
                    {% if iface.description is defined %}
                    <description>{{ iface.description }}</description>
                    {% endif %}

                    {% if iface.address is defined %}
                    <ipv4>
                        <primary>
                            <address>{{ iface.address }}</address>
                            <prefix-length>{{ iface.prefix_length | default(24) }}</prefix-length>
                        </primary>
                    </ipv4>
                    {% endif %}

                    {% if iface.ipv6 is defined %}
                    <ipv6>
                        <address>
                            <ipv6-address>{{ iface.ipv6.address }}</ipv6-address>
                            <prefix-length>{{ iface.ipv6.prefix_length | default(128) }}</prefix-length>
                        </address>
                    </ipv6>
                    {% endif %}

                    {% if iface.mac is defined %}
                    <mac>{{ iface.mac }}</mac>
                    {% endif %}

                    {% if iface.sap_id is defined %}
                    <sap>
                        <sap-id>{{ iface.sap_id }}</sap-id>
                        <admin-state>{{ iface.sap_admin_state | default('enable') }}</admin-state>
                    </sap>
                    {% endif %}

                    <admin-state>{{ iface.admin_state | default('enable') }}</admin-state>
                </interface>
                {% endif %}
                {% endfor %}
                <admin-state>{{ ies.admin_state | default('enable') }}</admin-state>
            </ies>
            {% endif %}
            {% endfor %}
        </service>
    </configure>
</config>
