<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>Base</router-name>
            <igmp>
                <admin-state>enable</admin-state>

                {# SSM Translation Logic #}
                {% if igmp is defined and 'ssm_translate' in igmp %}
                <ssm-translate>
                    {% for translate in igmp.ssm_translate %}
                    <group-range>
                        <start>{{ translate.start }}</start>
                        <end>{{ translate.end }}</end>
                        <source>
                            <source-address>{{ translate.source }}</source-address>
                        </source>
                    </group-range>
                    {% endfor %}
                </ssm-translate>
                {% endif %}

                {% if igmp is defined and 'query_interval' in igmp %}
                <query-interval>{{ igmp.query_interval }}</query-interval>
                {% endif %}

                {% if igmp is defined and 'interfaces' in igmp %}
                    {% for intf in igmp.interfaces %}
                    <interface>
                        <ip-interface-name>{{ intf.name }}</ip-interface-name>
                        <admin-state>enable</admin-state>
                        {% if intf.query_interval is defined %}
                        <query-interval>{{ intf.query_interval }}</query-interval>
                        {% endif %}
                        {% if intf.version is defined %}
                        <version>{{ intf.version }}</version>
                        {% endif %}
                    </interface>
                    {% endfor %}
                {% endif %}
            </igmp>
        </router>
    </configure>
</config>
