<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>Base</router-name>
            {% for intf in interfaces %}
            {% if intf.state | default('present') == 'absent' %}
            <interface operation="remove">
                <interface-name>{{ intf.name }}</interface-name>
            </interface>
            {% else %}
            <interface>
                <interface-name>{{ intf.name }}</interface-name>
                <admin-state>{{ intf.admin_state | default('enable') }}</admin-state>
                
                {% if intf.address is defined %}
                <ipv4>
                    <primary>
                        <address>{{ intf.address }}</address>
                        <prefix-length>{{ intf.mask }}</prefix-length>
                    </primary>
                </ipv4>
                {% endif %}

                {% if intf.ipv6 is defined %}
                <ipv6>
                    <address>
                        <ipv6-address>{{ intf.ipv6.address }}</ipv6-address>
                        <prefix-length>{{ intf.ipv6.prefix_length | default(intf.ipv6.mask | default(128)) }}</prefix-length>
                    </address>
                </ipv6>
                {% endif %}

                {% if intf.port is defined %}
                <port>{{ intf.port }}</port>
                {% endif %}

                {% if intf.loopback | default(false) %}
                <loopback/>
                {% endif %}

                {% if intf.ingress_ip_filter is defined %}
                <ingress>
                  <filter>
                    <ip>{{ intf.ingress_ip_filter }}</ip>
                  </filter>
                </ingress>
                {% endif %}

            </interface>
            {% endif %}
            {% endfor %}
        </router>
    </configure>
</config>
