<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>{{ router_instance | default('Base') }}</router-name>
            {% for intf in interfaces %}
            {% if intf.state | default('present') == 'absent' %}
            <interface operation="remove">
                <interface-name>{{ intf.name }}</interface-name>
            </interface>
            {% else %}
            <interface>
                <interface-name>{{ intf.name }}</interface-name>
                <admin-state>{{ intf.admin_state | default('enable') }}</admin-state>

                {% if intf.description is defined %}
                <description>{{ intf.description }}</description>
                {% endif %}

                {% if intf.address is defined %}
                <ipv4>
                    <primary>
                        <address>{{ intf.address }}</address>
                        <prefix-length>{{ intf.prefix_length }}</prefix-length>
                    </primary>
                </ipv4>
                {% endif %}

                {% if intf.ipv6 is defined %}
                <ipv6>
                    <address>
                        <ipv6-address>{{ intf.ipv6.address }}</ipv6-address>
                        <prefix-length>{{ intf.ipv6.prefix_length | default(128) }}</prefix-length>
                    </address>
                </ipv6>
                {% endif %}

                {% if intf.port is defined and intf.name != 'system' %}
                <port>{{ intf.port }}</port>
                {% endif %}

                {% if (intf.loopback | default(false)) and intf.name != 'system' %}
                <loopback/>
                {% endif %}

                {% if intf.mtu is defined %}
                <ip-mtu>{{ intf.mtu }}</ip-mtu>
                {% endif %}

                {% if intf.ingress_ip_filter is defined and intf.name != 'system' %}
                <ingress>
                  <filter>
                    <ip>{{ intf.ingress_ip_filter }}</ip>
                  </filter>
                </ingress>
                {% endif %}

                {% if intf.egress_ip_filter is defined and intf.name != 'system' %}
                <egress>
                  <filter>
                    <ip>{{ intf.egress_ip_filter }}</ip>
                  </filter>
                </egress>
                {% endif %}

            </interface>
            {% endif %}
            {% endfor %}
        </router>
    </configure>
</config>
