<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>{{ router_instance | default('Base') }}</router-name>
            <ldp>
                <admin-state>{{ ldp.admin_state | default('enable') }}</admin-state>

                {# Targeted LDP Sessions (for T-LDP Pseudowires & BGP-AD) #}
                {% if ldp.targeted_sessions is defined %}
                <targeted-session>
                    {% for peer in ldp.targeted_sessions %}
                    {% set peer_ip = peer.ip if peer is mapping else peer %}
                    {% set peer_state = peer.state | default('present') if peer is mapping else 'present' %}
                    {% if peer_state == 'absent' %}
                    <peer nc:operation="remove">
                        <ip-address>{{ peer_ip }}</ip-address>
                    </peer>
                    {% else %}
                    <peer>
                        <ip-address>{{ peer_ip }}</ip-address>
                        <admin-state>{{ (peer.admin_state | default('enable')) if peer is mapping else 'enable' }}</admin-state>
                    </peer>
                    {% endif %}
                    {% endfor %}
                </targeted-session>
                {% endif %}

                {# Interface Parameters (Dual-Stack IPv4 / IPv6) #}
                {% if ldp.interfaces is defined %}
                <interface-parameters>
                    {% if ldp.ipv4 | default(true) %}
                    <ipv4></ipv4>
                    {% endif %}
                    {% if ldp.ipv6 | default(false) %}
                    <ipv6></ipv6>
                    {% endif %}

                    {% for iface in ldp.interfaces %}
                    {% set iface_name = iface.name if iface is mapping else iface %}
                    {% set iface_state = iface.state | default('present') if iface is mapping else 'present' %}
                    {% if iface_state == 'absent' %}
                    <interface nc:operation="remove">
                        <ip-int-name>{{ iface_name }}</ip-int-name>
                    </interface>
                    {% else %}
                    <interface>
                        <ip-int-name>{{ iface_name }}</ip-int-name>
                        {% if (iface is mapping and iface.ipv4 | default(true)) or (iface is not mapping and ldp.ipv4 | default(true)) %}
                        <ipv4></ipv4>
                        {% endif %}
                        {% if iface is mapping and iface.ipv6 | default(false) %}
                        <ipv6></ipv6>
                        {% endif %}
                    </interface>
                    {% endif %}
                    {% endfor %}
                </interface-parameters>
                {% endif %}
            </ldp>
        </router>
    </configure>
</config>
