<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">

        <mirror>
            {% for dest in mirror_destinations %}
            {% if dest.state | default('present') == 'absent' %}
            <mirror-dest operation="remove">
                <service-name>{{ dest.name }}</service-name>
            </mirror-dest>
            {% else %}
            <mirror-dest>
                <service-name>{{ dest.name }}</service-name>
                <service-id>{{ dest.id }}</service-id>
                {% if dest.description is defined %}
                <description>{{ dest.description }}</description>
                {% endif %}

                {% if dest.sap is defined %}
                <sap>
                    <sap-id>{{ dest.sap }}</sap-id>
                </sap>
                {% endif %}

                <admin-state>{{ dest.admin_state | default('enable') }}</admin-state>
            </mirror-dest>
            {% endif %}
            {% endfor %}
        </mirror>

    </configure>
</config>
