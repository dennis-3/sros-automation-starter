<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">

        <mirror>
            {% for src in mirror_sources %}
            {% if src.state | default('present') == 'absent' %}
            <mirror-source operation="remove">
                <service-name>{{ src.name }}</service-name>
            </mirror-source>
            {% else %}
            <mirror-source>
                <service-name>{{ src.name }}</service-name>
                {% if src.description is defined %}
                <description>{{ src.description }}</description>
                {% endif %}
                <port>
                    <port-id>{{ src.monitor_port }}</port-id>
                    <ingress>{{ 'true' if src.ingress else 'false' }}</ingress>
                    <egress>{{ 'true' if src.egress else 'false' }}</egress>
                </port>
                <admin-state>{{ src.admin_state | default('enable') }}</admin-state>
            </mirror-source>
            {% endif %}
            {% endfor %}
        </mirror>

    </configure>
</config>
