<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>Base</router-name>

            {# --- SRGB Label Range --- #}
            <mpls-labels>
                {% if mpls_labels.sr_labels is defined %}
                <sr-labels>
                    <start>{{ mpls_labels.sr_labels.start }}</start>
                    <end>{{ mpls_labels.sr_labels.end }}</end>
                </sr-labels>
                {% endif %}
            </mpls-labels>

        </router>
    </configure>
</config>
