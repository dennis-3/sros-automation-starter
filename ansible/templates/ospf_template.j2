<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <router>
            <router-name>{{ router_instance | default('Base') }}</router-name>
            <ospf>
                <ospf-instance>{{ ospf.instance }}</ospf-instance>
                <admin-state>{{ ospf.admin_state | default('enable') }}</admin-state>

                {% if ospf.router_id is defined %}
                <router-id>{{ ospf.router_id }}</router-id>
                {% endif %}

                {# Multi-Area OSPF Architecture #}
                {% if ospf.areas is defined %}
                {% for area in ospf.areas %}
                {% if area.state | default('present') == 'absent' %}
                <area operation="remove">
                    <area-id>{{ area.id if area.id is defined else area.area_id }}</area-id>
                </area>
                {% else %}
                <area>
                    <area-id>{{ area.id if area.id is defined else area.area_id }}</area-id>

                    {# Passive Interfaces #}
                    {% for iface in area.passive_interfaces | default([]) %}
                    {% set iface_name = iface.name if iface is mapping else iface %}
                    {% set iface_state = iface.state | default('present') if iface is mapping else 'present' %}
                    {% if iface_state == 'absent' %}
                    <interface operation="remove">
                        <interface-name>{{ iface_name }}</interface-name>
                    </interface>
                    {% else %}
                    <interface>
                        <interface-name>{{ iface_name }}</interface-name>
                        <interface-type>{{ iface.interface_type | default('point-to-point') if iface is mapping else 'point-to-point' }}</interface-type>
                        <passive>true</passive>
                        <admin-state>{{ iface.admin_state | default('enable') if iface is mapping else 'enable' }}</admin-state>
                    </interface>
                    {% endif %}
                    {% endfor %}

                    {# Active Interfaces #}
                    {% for iface in area.active_interfaces | default([]) %}
                    {% set iface_name = iface.name if iface is mapping else iface %}
                    {% set iface_state = iface.state | default('present') if iface is mapping else 'present' %}
                    {% if iface_state == 'absent' %}
                    <interface operation="remove">
                        <interface-name>{{ iface_name }}</interface-name>
                    </interface>
                    {% else %}
                    <interface>
                        <interface-name>{{ iface_name }}</interface-name>
                        <interface-type>{{ iface.interface_type | default('point-to-point') if iface is mapping else 'point-to-point' }}</interface-type>
                        <admin-state>{{ iface.admin_state | default('enable') if iface is mapping else 'enable' }}</admin-state>
                        {% if iface is mapping and iface.metric is defined %}
                        <metric>{{ iface.metric }}</metric>
                        {% elif area.metric is defined %}
                        <metric>{{ area.metric }}</metric>
                        {% elif ospf.metric is defined %}
                        <metric>{{ ospf.metric }}</metric>
                        {% endif %}
                    </interface>
                    {% endif %}
                    {% endfor %}
                </area>
                {% endif %}
                {% endfor %}

                {# Single-Area Architecture (Backward Compatibility) #}
                {% elif ospf.area is defined %}
                <area>
                    <area-id>{{ ospf.area }}</area-id>

                    {# Handle Passive Interfaces (System) #}
                    {% for iface in ospf.passive_interfaces | default([]) %}
                    {% set iface_name = iface.name if iface is mapping else iface %}
                    {% set iface_state = iface.state | default('present') if iface is mapping else 'present' %}
                    {% if iface_state == 'absent' %}
                    <interface operation="remove">
                        <interface-name>{{ iface_name }}</interface-name>
                    </interface>
                    {% else %}
                    <interface>
                        <interface-name>{{ iface_name }}</interface-name>
                        <interface-type>{{ iface.interface_type | default('point-to-point') if iface is mapping else 'point-to-point' }}</interface-type>
                        <passive>true</passive>
                        <admin-state>{{ iface.admin_state | default('enable') if iface is mapping else 'enable' }}</admin-state>
                    </interface>
                    {% endif %}
                    {% endfor %}

                    {# Handle Active Core Interfaces #}
                    {% for iface in ospf.active_interfaces | default([]) %}
                    {% set iface_name = iface.name if iface is mapping else iface %}
                    {% set iface_state = iface.state | default('present') if iface is mapping else 'present' %}
                    {% if iface_state == 'absent' %}
                    <interface operation="remove">
                        <interface-name>{{ iface_name }}</interface-name>
                    </interface>
                    {% else %}
                    <interface>
                        <interface-name>{{ iface_name }}</interface-name>
                        <interface-type>{{ iface.interface_type | default('point-to-point') if iface is mapping else 'point-to-point' }}</interface-type>
                        <admin-state>{{ iface.admin_state | default('enable') if iface is mapping else 'enable' }}</admin-state>
                        {% if iface is mapping and iface.metric is defined %}
                        <metric>{{ iface.metric }}</metric>
                        {% elif ospf.metric is defined %}
                        <metric>{{ ospf.metric }}</metric>
                        {% endif %}
                    </interface>
                    {% endif %}
                    {% endfor %}

                </area>
                {% endif %}
            </ospf>
        </router>
    </configure>
</config>
