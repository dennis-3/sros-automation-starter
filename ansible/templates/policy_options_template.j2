<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <policy-options>
            {# Prefix Lists Configuration #}
            {% if policy_options.prefix_lists is defined %}
            {% for pl in policy_options.prefix_lists %}
            {% if pl.state | default('present') == 'absent' %}
            <prefix-list nc:operation="remove">
                <name>{{ pl.name }}</name>
            </prefix-list>
            {% else %}
            <prefix-list>
                <name>{{ pl.name }}</name>
                {% for entry in pl.prefixes | default([]) %}
                <prefix>
                    <ip-prefix>{{ entry.ip }}</ip-prefix>
                    <type>{{ entry.type }}</type>
                </prefix>
                {% endfor %}
            </prefix-list>
            {% endif %}
            {% endfor %}
            {% endif %}

            {# BGP Community Definitions #}
            {% if policy_options.communities is defined %}
            {% for comm in policy_options.communities %}
            {% if comm.state | default('present') == 'absent' %}
            <community nc:operation="remove">
                <name>{{ comm.name }}</name>
            </community>
            {% else %}
            <community>
                <name>{{ comm.name }}</name>
                {% if comm.description is defined %}
                <description>{{ comm.description }}</description>
                {% endif %}
                {% for m in comm.members | default([]) %}
                <member>
                    <member>{{ m }}</member>
                </member>
                {% endfor %}
            </community>
            {% endif %}
            {% endfor %}
            {% endif %}

            {# Policy Statements Configuration #}
            {% for policy in policy_options.policy_statements | default([]) %}
            {% if policy.state | default('present') == 'absent' %}
            <policy-statement nc:operation="remove">
                <name>{{ policy.name }}</name>
            </policy-statement>
            {% else %}
            <policy-statement>
                <name>{{ policy.name }}</name>
                {% if policy.description is defined %}
                <description>{{ policy.description }}</description>
                {% endif %}

                {% if policy.entries is defined %}
                {% for entry in policy.entries %}
                <entry>
                    <entry-id>{{ entry.id }}</entry-id>
                    {% if entry.description is defined %}
                    <description>{{ entry.description }}</description>
                    {% endif %}

                    {# Match Criteria: <from> #}
                    {% if entry.from is defined %}
                    {% set from_ctx = entry.from %}
                    {% set pl_entries = from_ctx.prefix_list if (from_ctx.prefix_list is defined and from_ctx.prefix_list is iterable and from_ctx.prefix_list is not string) else ([from_ctx.prefix_list] if (from_ctx.prefix_list is defined and from_ctx.prefix_list) else []) %}
                    {% set proto_from = from_ctx.protocol | default(none) %}
                    {% set comm_from = from_ctx.community | default(none) %}

                    {% if pl_entries or proto_from or comm_from %}
                    <from>
                        {% for pl_name in pl_entries %}
                        <prefix-list>{{ pl_name }}</prefix-list>
                        {% endfor %}
                        {% if comm_from %}
                        <community>{{ comm_from }}</community>
                        {% endif %}
                        {% if proto_from %}
                        <protocol>
                            <name>{{ proto_from }}</name>
                        </protocol>
                        {% endif %}
                    </from>
                    {% endif %}
                    {% endif %}

                    {# Target Criteria: <to> (Sibling to <from> in SR OS YANG) #}
                    {% if entry.to is defined and entry.to.protocol is defined %}
                    <to>
                        <protocol>
                            <name>{{ entry.to.protocol }}</name>
                        </protocol>
                    </to>
                    {% endif %}

                    {# Action #}
                    <action>
                        <action-type>{{ entry.action | default('accept') }}</action-type>
                        {% if entry.add_communities is defined %}
                        {% for comm_name in entry.add_communities %}
                        <community>
                            <add>{{ comm_name }}</add>
                        </community>
                        {% endfor %}
                        {% endif %}
                    </action>
                </entry>
                {% endfor %}
                {% endif %}

                <default-action>
                    <action-type>{{ policy.default_action | default('reject') }}</action-type>
                </default-action>
            </policy-statement>
            {% endif %}
            {% endfor %}
        </policy-options>
    </configure>
</config>
