<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <policy-options>
            {# Prefix Lists Configuration #}
            {% if policy_options.prefix_lists is defined %}
            {% for pl in policy_options.prefix_lists %}
            {% if pl.state | default('present') == 'absent' %}
            <prefix-list operation="remove">
                <name>{{ pl.name }}</name>
            </prefix-list>
            {% else %}
            <prefix-list>
                <name>{{ pl.name }}</name>
                {% for entry in pl.prefixes %}
                <prefix>
                    <ip-prefix>{{ entry.ip }}</ip-prefix>
                    <type>{{ entry.type }}</type>
                </prefix>
                {% endfor %}
            </prefix-list>
            {% endif %}
            {% endfor %}
            {% endif %}

            {# --- Generic BGP Community Definitions --- #}
            {% if policy_options.communities is defined %}
            {% for comm in policy_options.communities %}
            {% if comm.state | default('present') == 'absent' %}
            <community operation="remove">
                <name>{{ comm.name }}</name>
            </community>
            {% else %}
            <community>
                <name>{{ comm.name }}</name>
                {% if comm.description is defined %}
                <description>{{ comm.description }}</description>
                {% endif %}
                {% for m in comm.members | default([]) %}
                <member>
                    <member>{{ m }}</member>
                </member>
                {% endfor %}
            </community>
            {% endif %}
            {% endfor %}
            {% endif %}

            {# --- Legacy Community Definitions for backward compatibility --- #}
            {% if region is defined and policy_options.communities is not defined %}
                {% set as_prefix = "40" if (asn | default(65000)) == 65540 else "50" %}
                {% set geo_tag = "2020" if region == "West" else "2010" %}

                <community>
                    <name>Client-CIDR-{{ region }}</name>
                    <member>
                        <member>{{ as_prefix|string }}:100</member>
                    </member>
                    <member>
                        <member>{{ as_prefix|string }}:{{ geo_tag|string }}</member>
                    </member>
                </community>

                <community>
                    <name>Client-External-{{ region }}</name>
                    <member>
                        <member>{{ as_prefix|string }}:200</member>
                    </member>
                    <member>
                        <member>{{ as_prefix|string }}:{{ geo_tag|string }}</member>
                    </member>
                </community>
            {% endif %}

            {# Policy Statements Configuration #}
            {% for policy in policy_options.policy_statements %}
            {% if policy.state | default('present') == 'absent' %}
            <policy-statement operation="remove">
                <name>{{ policy.name }}</name>
            </policy-statement>
            {% else %}
            <policy-statement>
                <name>{{ policy.name }}</name>
                {% if policy.description is defined %}
                <description>{{ policy.description }}</description>
                {% endif %}

                {% if policy.entries is defined %}
                {% for entry in policy.entries %}
                <entry>
                    <entry-id>{{ entry.id }}</entry-id>
                    {% if entry.description is defined %}
                    <description>{{ entry.description }}</description>
                    {% endif %}
                    <from>
                        {# Loop through prefix lists if provided as a list #}
                        {% if entry.from_prefix_list is defined %}
                        {% for pl_name in entry.from_prefix_list %}
                        <prefix-list>{{ pl_name }}</prefix-list>
                        {% endfor %}
                        {% endif %}

                        {% if entry.from_protocol is defined %}
                        <protocol>
                            <name>{{ entry.from_protocol }}</name>
                        </protocol>
                        {% endif %}

                        {% if entry.to_protocol is defined %}
                        <protocol>
                            <name>{{ entry.to_protocol }}</name>
                        </protocol>
                        {% endif %}
                    </from>
                    <action>
                        <action-type>{{ entry.action }}</action-type>

                        {# --- Add Communities: Only if they exist in variables --- #}
                        {% if entry.add_communities is defined %}
                            {% for comm_name in entry.add_communities %}
                            <community>
                                <add>{{ comm_name }}</add>
                            </community>
                            {% endfor %}
                        {% endif %}
                    </action>
                </entry>
                {% endfor %}
                {% endif %}

                <default-action>
                    <action-type>{{ policy.default_action }}</action-type>
                </default-action>
            </policy-statement>
            {% endif %}
            {% endfor %}
        </policy-options>
    </configure>
</config>
