<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <service>
            {% for pw in pw_templates %}
            {% if pw.state | default('present') == 'absent' %}
            <pw-template nc:operation="remove">
                <pw-template-name>{{ pw.name }}</pw-template-name>
            </pw-template>
            {% else %}
            <pw-template>
                <pw-template-name>{{ pw.name }}</pw-template-name>
                <pw-template-id>{{ pw.id }}</pw-template-id>

                {# Provisioned SDP Logic #}
                {% if pw.provisioned_sdp is defined %}
                <provisioned-sdp>{{ pw.provisioned_sdp }}</provisioned-sdp>
                {% endif %}

                {# Split Horizon Group (Optional) #}
                {% if pw.shg_name is defined %}
                <split-horizon-group>
                    <name>{{ pw.shg_name }}</name>
                </split-horizon-group>
                {% endif %}
            </pw-template>
            {% endif %}
            {% endfor %}
        </service>
    </configure>
</config>
