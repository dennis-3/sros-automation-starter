<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <service>
            {% for pw in pw_templates %}
            <pw-template>
                <pw-template-name>{{ pw.name }}</pw-template-name>
                <pw-template-id>{{ pw.id }}</pw-template-id>

                {# Step 3: Provisioned SDP Logic #}
                {% if pw.provisioned_sdp is defined %}
                <provisioned-sdp>{{ pw.provisioned_sdp }}</provisioned-sdp>
                {% endif %}

                {# Step 3b/4b: Split Horizon Group #}
                <split-horizon-group>
                    <name>{{ pw.shg_name }}</name>
                </split-horizon-group>
            </pw-template>
            {% endfor %}
        </service>
    </configure>
</config>
