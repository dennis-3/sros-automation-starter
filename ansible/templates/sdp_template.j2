<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <service>
            {% for sdp in sdp_configs %}
            {% if sdp.state | default('present') == 'absent' %}
            <sdp operation="remove">
                <sdp-id>{{ sdp.id }}</sdp-id>
            </sdp>
            {% else %}
            <sdp>
                <sdp-id>{{ sdp.id }}</sdp-id>
                <delivery-type>{{ sdp.delivery_type | default('mpls') }}</delivery-type>
                {% if sdp.description is defined %}
                <description>{{ sdp.description }}</description>
                {% endif %}

                {% if sdp.far_end is mapping and sdp.far_end.ip_address is defined %}
                {% set fe_ip = sdp.far_end.ip_address %}
                {% else %}
                {% set fe_ip = sdp.far_end_ip | default(sdp.far_end) %}
                {% endif %}
                <far-end>
                  <ip-address>{{ fe_ip }}</ip-address>
                </far-end>

                {% if sdp.ldp | default(false) %}
                <ldp>true</ldp>
                {% elif sdp.sr_isis | default(false) %}
                <sr-isis>true</sr-isis>
                {% elif sdp.sr_ospf | default(false) %}
                <sr-ospf>true</sr-ospf>
                {% elif sdp.sr_te | default(false) %}
                <sr-te>true</sr-te>
                {% elif sdp.lsp is defined or sdp.lsp_name is defined %}
                <lsp>
                  <lsp-name>{{ sdp.lsp | default(sdp.lsp_name) }}</lsp-name>
                </lsp>
                {% endif %}

                <signaling>{{ sdp.signaling | default('tldp') }}</signaling>
                <admin-state>{{ sdp.admin_state | default('enable') }}</admin-state>
            </sdp>
            {% endif %}
            {% endfor %}
        </service>
    </configure>
</config>
