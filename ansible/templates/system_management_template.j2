<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <system>
            {# ================================================================= #}
            {# NETWORK TIME PROTOCOL (NTP)                                       #}
            {# ================================================================= #}
            {% if ntp is defined %}
            <time>
                <ntp>
                    <admin-state>{{ ntp.admin_state | default('enable') }}</admin-state>
                    {% for srv in ntp.servers | default([]) %}
                    {% if srv.state | default('present') == 'absent' %}
                    <server nc:operation="remove">
                        <address>{{ srv.address if srv.address is defined else srv }}</address>
                    </server>
                    {% else %}
                    <server>
                        <address>{{ srv.address if srv.address is defined else srv }}</address>
                        {% if srv.router_instance is defined %}
                        <router-instance>{{ srv.router_instance }}</router-instance>
                        {% endif %}
                        {% if srv.prefer is defined and srv.prefer %}
                        <prefer>true</prefer>
                        {% endif %}
                    </server>
                    {% endif %}
                    {% endfor %}
                </ntp>
            </time>
            {% endif %}

            {# ================================================================= #}
            {# CENTRALIZED AAA SECURITY & TACACS+ SERVERS                        #}
            {# ================================================================= #}
            {% if tacplus is defined %}
            <security>
                <aaa>
                    <tacplus>
                        {% for srv in tacplus.servers | default([]) %}
                        {% if srv.state | default('present') == 'absent' %}
                        <server nc:operation="remove">
                            <index>{{ srv.index | default(loop.index) }}</index>
                        </server>
                        {% else %}
                        <server>
                            <index>{{ srv.index | default(loop.index) }}</index>
                            <address>{{ srv.address }}</address>
                            {% if srv.secret is defined %}
                            <secret>{{ srv.secret }}</secret>
                            {% endif %}
                            {% if srv.port is defined %}
                            <port>{{ srv.port }}</port>
                            {% endif %}
                            {% if srv.timeout is defined %}
                            <timeout>{{ srv.timeout }}</timeout>
                            {% endif %}
                        </server>
                        {% endif %}
                        {% endfor %}
                    </tacplus>
                </aaa>
            </security>
            {% endif %}

            {# ================================================================= #}
            {# DOMAIN NAME RESOLUTION (DNS)                                     #}
            {# ================================================================= #}
            {% if dns is defined %}
            <dns>
                {% for srv in dns.servers | default([]) %}
                {% if srv.state | default('present') == 'absent' %}
                <server nc:operation="remove">
                    <address>{{ srv.address if srv.address is defined else srv }}</address>
                </server>
                {% else %}
                <server>
                    <address>{{ srv.address if srv.address is defined else srv }}</address>
                </server>
                {% endif %}
                {% endfor %}
            </dns>
            {% endif %}
        </system>
    </configure>
</config>
