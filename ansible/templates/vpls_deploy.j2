<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">

        <service>
            {% for vpls in vpls_services %}
            {% if vpls.state | default('present') == 'absent' %}
            <vpls operation="remove">
                <service-name>{{ vpls.name | default(vpls.id) }}</service-name>
            </vpls>
            {% else %}
            <vpls>
                <service-name>{{ vpls.name | default(vpls.id) }}</service-name>
                {% if vpls.id is defined %}
                <service-id>{{ vpls.id }}</service-id>
                {% endif %}
                <customer>{{ vpls.customer_id | default('1') }}</customer>
                {% if vpls.description is defined %}
                <description>{{ vpls.description }}</description>
                {% endif %}

                {# BGP Context: Only renders if RD is defined #}
                {% if vpls.rd is defined %}
                <bgp>
                    <bgp-instance>1</bgp-instance>
                    {# <instance-id>1</instance-id> #}
                    <route-distinguisher>{{ vpls.rd }}</route-distinguisher>
                    <route-target>
                        <export>{{ vpls.rt }}</export>
                        <import>{{ vpls.rt }}</import>
                    </route-target>

                    {# Updated per tree output: pw-template-binding is a list #}
                    <pw-template-binding>
                        <pw-template-name>{{ vpls.pw_template }}</pw-template-name>
                    </pw-template-binding>
                    {# </bgp-instance> #}
                </bgp>
                {% endif %}

                {# BGP-VPLS Context: Only renders if VE parameters exist #}
                {% if vpls.ve_id is defined %}
                <bgp-vpls>
                    <admin-state>enable</admin-state>
                    <maximum-ve-id>10</maximum-ve-id>
                    <ve>
                        <id>{{ vpls.ve_id }}</id>
                        <name>{{ vpls.ve_name }}</name>
                    </ve>
                </bgp-vpls>
                {% endif %}

                {# BGP Auto-Discovery #}
                {% if vpls.vpls_id is defined %}
                <bgp-ad>
                    <admin-state>enable</admin-state>
                    <vpls-id>{{ vpls.vpls_id }}</vpls-id>
                </bgp-ad>
                {% endif %}

                {# IGMP Snooping #}
                {% if vpls.igmp_snooping | default(false) %}
                <igmp-snooping>
                    <admin-state>enable</admin-state>
                </igmp-snooping>
                {% endif %}

                {% if vpls.saps is defined %}
                {% for sap in vpls.saps %}
                {% if sap.state | default('present') == 'absent' %}
                <sap operation="remove">
                    <sap-id>{{ sap.port | default(sap.id) }}</sap-id>
                </sap>
                {% else %}
                <sap>
                    <sap-id>{{ sap.port | default(sap.id) }}</sap-id>
                    <admin-state>{{ sap.admin_state | default('enable') }}</admin-state>

                    <igmp-snooping>
                        {% if sap.is_mrouter | default (false) %}
                        <mrouter-port>true</mrouter-port>
                        {% endif %}

                        {# Logic for Static (*,G) Multicast Groups #}
                        {% if sap.static_groups is defined %}
                        <static>
                            {% for group in sap.static_groups %}
                            <group>
                                <group-address>{{ group.address }}</group-address>

                                {# Handle (*,G) #}
                                {% if group.starg | default(false) %}
                                <starg/>
                                {% endif %}

                                {# Handle (S,G) #}
                                {% if group.sources is defined %}
                                    {% for src in group.sources %}
                                    <source>
                                        <source-address>{{ src }}</source-address>
                                    </source>
                                    {% endfor %}
                                {% endif %}
                            </group>
                            {% endfor %}
                        </static>
                        {% endif %}
                    </igmp-snooping>
                </sap>
                {% endif %}
                {% endfor %}
                {% endif %}

                {# BGP-EVPN Context #}
                {% if vpls.evpn is defined %}
                <bgp-evpn>
                    <evi>{{ vpls.evpn.evi | default(vpls.id) }}</evi>
                    <mpls>
                        <admin-state>{{ vpls.evpn.admin_state | default('enable') }}</admin-state>
                        {% if vpls.evpn.auto_bind_tunnel is defined %}
                        <auto-bind-tunnel>
                            <resolution>{{ vpls.evpn.auto_bind_tunnel.resolution | default(vpls.evpn.auto_bind_tunnel) }}</resolution>
                        </auto-bind-tunnel>
                        {% endif %}
                    </mpls>
                </bgp-evpn>
                {% endif %}

                {# Forwarding Plane: mesh-sdps #}
                {% if vpls.mesh_sdps is defined %}
                {% for sdp in vpls.mesh_sdps %}
                {% set sdp_bind_id = (sdp.id ~ ':' ~ (sdp.vc_id | default(vpls.vc_id))) if sdp is mapping else (sdp ~ ':' ~ vpls.vc_id) %}
                {% set sdp_state = sdp.state | default('present') if sdp is mapping else 'present' %}
                {% if sdp_state == 'absent' %}
                <mesh-sdp operation="remove">
                    <sdp-bind-id>{{ sdp_bind_id }}</sdp-bind-id>
                </mesh-sdp>
                {% else %}
                <mesh-sdp>
                    <sdp-bind-id>{{ sdp_bind_id }}</sdp-bind-id>
                    <admin-state>{{ (sdp.admin_state | default('enable')) if sdp is mapping else 'enable' }}</admin-state>
                </mesh-sdp>
                {% endif %}
                {% endfor %}
                {% endif %}

                {# Forwarding Plane: spoke-sdps #}
                {% if vpls.spokes is defined or vpls.spoke_sdps is defined %}
                {% for spoke in (vpls.spokes | default(vpls.spoke_sdps)) %}
                {% set spoke_bind_id = (spoke.sdp_id ~ ':' ~ spoke.vc_id) if spoke.sdp_id is defined else ((spoke.id ~ ':' ~ (spoke.vc_id | default(vpls.vc_id))) if spoke is mapping else (spoke ~ ':' ~ vpls.vc_id)) %}
                {% set spoke_state = spoke.state | default('present') if spoke is mapping else 'present' %}
                {% if spoke_state == 'absent' %}
                <spoke-sdp operation="remove">
                    <sdp-bind-id>{{ spoke_bind_id }}</sdp-bind-id>
                </spoke-sdp>
                {% else %}
                <spoke-sdp>
                    <sdp-bind-id>{{ spoke_bind_id }}</sdp-bind-id>
                    <admin-state>{{ (spoke.admin_state | default('enable')) if spoke is mapping else 'enable' }}</admin-state>
                </spoke-sdp>
                {% endif %}
                {% endfor %}
                {% endif %}

                <admin-state>{{ vpls.admin_state | default('enable') }}</admin-state>
            </vpls>
            {% endif %}
            {% endfor %}
        </service>

    </configure>
</config>
