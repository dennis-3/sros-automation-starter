<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
    <configure xmlns="urn:nokia.com:sros:ns:yang:sr:conf">
        <service>
            {% for vprn in vprn_services %}
            {% if vprn.state | default('present') == 'absent' %}
            <vprn operation="remove">
                <service-name>{{ vprn.name }}</service-name>
            </vprn>
            {% else %}
            <vprn>
                <service-name>{{ vprn.name }}</service-name>
                <admin-state>{{ vprn.admin_state | default('enable') }}</admin-state>

                {% if vprn.description is defined %}
                <description>{{ vprn.description }}</description>
                {% endif %}

                {% if vprn.id is defined %}
                <service-id>{{ vprn.id }}</service-id>
                {% endif %}

                <customer>{{ vprn.customer_id | default('1') }}</customer>

                {% if vprn.as_number is defined %}
                <autonomous-system>{{ vprn.as_number }}</autonomous-system>
                {% endif %}

                {% if vprn.router_id is defined %}
                <router-id>{{ vprn.router_id }}</router-id>
                {% endif %}

                {# --- IGMP SECTION --- #}
                {% if vprn.igmp is defined %}
                <igmp>
                    <admin-state>{{ vprn.igmp.admin_state | default('enable') }}</admin-state>

                    {% if vprn.igmp.interfaces is defined %}
                        {% for igmp_intf in vprn.igmp.interfaces %}
                        <interface>
                            <ip-interface-name>{{ igmp_intf.name }}</ip-interface-name>
                            <admin-state>enable</admin-state>

                            {# Static Group Joins for Lab Testing #}
                            {% if igmp_intf.static_groups is defined %}
                            <static>
                                {% for group in igmp_intf.static_groups %}
                                <group>
                                    <group-address>{{ group.ip }}</group-address>
                                    <source>
                                        <source-address>{{ group.source }}</source-address>
                                    </source>
                                </group>
                                {% endfor %}
                            </static>
                            {% endif %}
                        </interface>
                        {% endfor %}
                    {% endif %}
                </igmp>
                {% endif %}

                {# --- PIM MULTICAST SECTION --- #}
                {% if vprn.pim is defined %}
                <pim>
                    <admin-state>{{ vprn.pim.admin_state | default('enable') }}</admin-state>

                    {# Interface-specific PIM configuration #}
                    {% if vprn.pim.interfaces is defined %}
                        {% for pim_intf in vprn.pim.interfaces %}
                        <interface>
                            <interface-name>{{ pim_intf.name }}</interface-name>
                            <admin-state>enable</admin-state>
                        </interface>
                        {% endfor %}
                    {% endif %}
                </pim>
                {% endif %}

                {# --- NG-MVPN SECTION --- #}
                {% if vprn.mvpn is defined %}
                <mvpn>
                    {# Auto-discovery and C-Multicast Signaling #}
                    <auto-discovery>
                        <type>{{ vprn.mvpn.auto_discovery | default('bgp') }}</type>
                    </auto-discovery>

                    <c-mcast-signaling>{{ vprn.mvpn.c_mcast_signaling | default('bgp') }}</c-mcast-signaling>

                    <vrf-target>
                        <unicast>{{ vprn.mvpn.vrf_target_unicast | lower }}</unicast>
                    </vrf-target>

                    {# Provider Tunnel #}
                    {% if vprn.mvpn.provider_tunnel is defined %}
                    <provider-tunnel>
                        {% if vprn.mvpn.provider_tunnel.inclusive is defined %}
                        <inclusive>
                            {% if vprn.mvpn.provider_tunnel.inclusive.type == 'mldp' %}
                            <mldp>
                                <admin-state>enable</admin-state>
                            </mldp>
                            {% elif vprn.mvpn.provider_tunnel.inclusive.type == 'rsvp' %}
                            <rsvp>
                                <admin-state>enable</admin-state>
                            </rsvp>
                            {% elif vprn.mvpn.provider_tunnel.inclusive.type == 'bier' %}
                            <bier>
                                <admin-state>enable</admin-state>
                                <sub-domain>{{ vprn.mvpn.provider_tunnel.inclusive.sub_domain_id | default('0') }}</sub-domain>
                            </bier>
                            {% endif %}
                        </inclusive>
                        {% endif %}

                        {% if vprn.mvpn.provider_tunnel.selective is defined %}
                        <selective>
                            {% if vprn.mvpn.provider_tunnel.selective.type == 'mldp' %}
                            <mldp>
                                <admin-state>enable</admin-state>
                            </mldp>
                            {% elif vprn.mvpn.provider_tunnel.selective.type == 'rsvp' %}
                            <rsvp>
                                <admin-state>enable</admin-state>
                            </rsvp>
                            {% elif vprn.mvpn.provider_tunnel.selective.type == 'bier' %}
                            <bier>
                                <admin-state>enable</admin-state>
                                <sub-domain>{{ vprn.mvpn.provider_tunnel.selective.sub_domain_id | default('0') }}</sub-domain>
                            </bier>
                            {% endif %}

                            <auto-discovery>{{ vprn.mvpn.provider_tunnel.selective.auto_discovery | lower }}</auto-discovery>

                            {% if vprn.mvpn.provider_tunnel.selective.data_threshold is defined %}
                            <data-threshold>
                                {% for entry in vprn.mvpn.provider_tunnel.selective.data_threshold %}
                                <group-prefix>
                                    <ip-group-prefix>{{ entry.prefix }}</ip-group-prefix>
                                    <threshold>{{ entry.threshold_kbps }}</threshold>
                                </group-prefix>
                                {% endfor %}
                            </data-threshold>
                            {% endif %}
                        </selective>
                        {% endif %}
                    </provider-tunnel>
                    {% endif %}
                </mvpn>
                {% endif %}

                {# --- BGP-IPVPN SECTION --- #}
                {% if vprn.bgp_ipvpn is defined %}
                <bgp-ipvpn>
                    <mpls>
                        <admin-state>enable</admin-state>

                        {% if vprn.bgp_ipvpn.route_distinguisher is defined %}
                        <route-distinguisher>{{ vprn.bgp_ipvpn.route_distinguisher }}</route-distinguisher>
                        {% endif %}

                        {% if vprn.bgp_ipvpn.vrf_target is defined %}
                        <vrf-target>
                            <community>target:{{ vprn.bgp_ipvpn.vrf_target }}</community>
                        </vrf-target>
                        {% endif %}

                        {% if vprn.bgp_ipvpn.export_policy is defined and vprn.bgp_ipvpn.export_policy %}
                        <vrf-export>
                            {% if vprn.bgp_ipvpn.export_policy is iterable and vprn.bgp_ipvpn.export_policy is not string %}
                            {% for pol in vprn.bgp_ipvpn.export_policy %}
                            <policy>{{ pol }}</policy>
                            {% endfor %}
                            {% else %}
                            <policy>{{ vprn.bgp_ipvpn.export_policy }}</policy>
                            {% endif %}
                        </vrf-export>
                        {% endif %}

                        {% if vprn.bgp_ipvpn.import_policy is defined and vprn.bgp_ipvpn.import_policy %}
                        <vrf-import>
                            {% if vprn.bgp_ipvpn.import_policy is iterable and vprn.bgp_ipvpn.import_policy is not string %}
                            {% for pol in vprn.bgp_ipvpn.import_policy %}
                            <policy>{{ pol }}</policy>
                            {% endfor %}
                            {% else %}
                            <policy>{{ vprn.bgp_ipvpn.import_policy }}</policy>
                            {% endif %}
                        </vrf-import>
                        {% endif %}

                        {% if vprn.bgp_ipvpn.auto_bind_tunnel is defined %}
                        {% set abt = vprn.bgp_ipvpn.auto_bind_tunnel %}
                        {% set is_any = (abt == 'any') or (abt is mapping and abt.resolution == 'any') %}
                        <auto-bind-tunnel>
                            {% if is_any %}
                            <resolution>any</resolution>
                            {% else %}
                            <resolution>{{ abt.resolution | default('filter') if abt is mapping else 'filter' }}</resolution>
                            <resolution-filter>
                                {% set filter_type = abt.type if (abt is mapping and abt.type is defined) else abt %}
                                {% if filter_type == 'bgp' %}
                                <bgp>true</bgp>
                                {% elif filter_type == 'ldp' %}
                                <ldp>true</ldp>
                                {% elif filter_type == 'rsvp' %}
                                <rsvp>true</rsvp>
                                {% elif filter_type == 'sr-ospf' %}
                                <sr-ospf>true</sr-ospf>
                                {% elif filter_type == 'sr-isis' %}
                                <sr-isis>true</sr-isis>
                                {% elif filter_type == 'sr-te' %}
                                <sr-te>true</sr-te>
                                {% endif %}
                            </resolution-filter>
                            {% endif %}
                        </auto-bind-tunnel>
                        {% endif %}
                    </mpls>
                </bgp-ipvpn>
                {% endif %}

                {# --- BGP PEERING SECTION --- #}
                {% if vprn.bgp is defined %}
                <bgp>
                    {% if vprn.bgp.router_id is defined %}
                    <router-id>{{ vprn.bgp.router_id }}</router-id>
                    {% endif %}

                    {# Loop through BGP groups #}
                    {% for group in vprn.bgp.groups %}
                    <group>
                        <group-name>{{ group.name }}</group-name>
                        <peer-as>{{ group.peer_as }}</peer-as>

                        {% if group.as_override | default(false) %}
                        <as-override>true</as-override>
                        {% endif %}

                        <family>
                            {% if group.family is defined and group.family is mapping %}
                            {% for fam, state in group.family.items() %}
                            <{{ fam | replace('_', '-') }}>{{ 'true' if state else 'false' }}</{{ fam | replace('_', '-') }}>
                            {% endfor %}
                            {% elif group.family is defined and (group.family is iterable and group.family is not string) %}
                            {% for fam in group.family %}
                            <{{ fam | replace('_', '-') }}>true</{{ fam | replace('_', '-') }}>
                            {% endfor %}
                            {% else %}
                            {# Fallback for legacy boolean flags #}
                            {% if group.family_ipv4 is defined %}<ipv4>{{ 'true' if group.family_ipv4 else 'false' }}</ipv4>{% endif %}
                            {% if group.family_ipv6 | default(false) %}<ipv6>true</ipv6>{% endif %}
                            {% endif %}
                        </family>

                        {# Policy Handling #}
                        {% if group.export_policy is defined and group.export_policy %}
                        <export>
                            {% for policy in group.export_policy %}
                            <policy>{{ policy }}</policy>
                            {% endfor %}
                        </export>
                        {% endif %}

                        {% if group.import_policy is defined and group.import_policy %}
                        <import>
                            {% for policy in group.import_policy %}
                            <policy>{{ policy }}</policy>
                            {% endfor %}
                        </import>
                        {% endif %}
                    </group>

                    {# Loop through neighbors belonging to this specific group #}
                    {% for neighbor in group.neighbors %}
                    <neighbor>
                        <ip-address>{{ neighbor.ip }}</ip-address>
                        <admin-state>enable</admin-state>
                        {% if neighbor.description is defined %}
                        <description>{{ neighbor.description }}</description>
                        {% endif %}
                        <group>{{ group.name }}</group>
                    </neighbor>
                    {% endfor %}
                    {% endfor %}
                </bgp>
                {% endif %}

                {# --- INTERFACES SECTION --- #}
                {% for interface in vprn.interfaces %}
                {% if interface.state | default('present') == 'absent' %}
                <interface operation="remove">
                    <interface-name>{{ interface.name }}</interface-name>
                </interface>
                {% else %}
                <interface>
                    <interface-name>{{ interface.name }}</interface-name>
                    <admin-state>{{ interface.admin_state | default('enable') }}</admin-state>

                    {% if interface.description is defined %}
                    <description>{{ interface.description }}</description>
                    {% endif %}

                    {% if interface.loopback | default(false) %}
                    <loopback/>
                    {% endif %}

                    {% if interface.address is defined %}
                    <ipv4>
                        <primary>
                            <address>{{ interface.address }}</address>
                            <prefix-length>{{ interface.mask | default(interface.prefix_length | default(24)) }}</prefix-length>
                        </primary>
                    </ipv4>
                    {% endif %}

                    {% if interface.ipv6 is defined %}
                    <ipv6>
                        <address>
                            <ipv6-address>{{ interface.ipv6.address }}</ipv6-address>
                            <prefix-length>{{ interface.ipv6.prefix_length | default(interface.ipv6.mask | default(128)) }}</prefix-length>
                        </address>
                    </ipv6>
                    {% endif %}

                    {% if interface.port is defined %}
                    <port>{{ interface.port }}</port>
                    {% endif %}

                    {% if interface.sap is defined %}
                    <sap>
                        <sap-id>{{ interface.sap }}</sap-id>
                        <admin-state>{{ interface.sap_admin_state | default('enable') }}</admin-state>
                    </sap>
                    {% endif %}

                    {% if interface.mtu is defined %}
                    <ip-mtu>{{ interface.mtu }}</ip-mtu>
                    {% endif %}

                    {% if interface.ingress_ip_filter is defined %}
                    <ingress>
                        <filter>
                            <ip>{{ interface.ingress_ip_filter }}</ip>
                        </filter>
                    </ingress>
                    {% endif %}

                    {% if interface.egress_ip_filter is defined %}
                    <egress>
                        <filter>
                            <ip>{{ interface.egress_ip_filter }}</ip>
                        </filter>
                    </egress>
                    {% endif %}
                </interface>
                {% endif %}
                {% endfor %}
            </vprn>
            {% endif %}
            {% endfor %}
        </service>
    </configure>
</config>
